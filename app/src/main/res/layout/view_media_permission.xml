<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_video_access"
            android:tint="@color/glass_text_accent" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/media_permission_title"
            android:textColor="@color/glass_text_primary"
            android:textSize="22sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/media_permission_description"
            android:textColor="@color/glass_text_secondary"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/permissionAllowButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minWidth="160dp"
            android:minHeight="52dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/media_permission_allow"
            android:textAllCaps="false"
            android:textColor="@color/media_permission_button_text"
            android:textSize="14sp"
            app:backgroundTint="@color/glass_text_accent"
            app:cornerRadius="20dp" />

        <TextView
            android:id="@+id/permissionNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="@string/media_permission_note"
            android:textColor="@color/glass_text_tertiary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
