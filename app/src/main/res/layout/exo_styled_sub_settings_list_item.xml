<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:minWidth="224dp"
    android:minHeight="48dp" android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp"
    android:background="@drawable/player_control_ripple">
    <ImageView android:id="@+id/exo_check" android:layout_width="20dp" android:layout_height="20dp"
        android:layout_marginEnd="12dp" android:visibility="invisible" android:src="@drawable/exo_styled_controls_check"
        app:tint="@color/glass_text_accent"/>
    <TextView android:id="@+id/exo_text" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:fontFamily="sans-serif-medium" android:textSize="14sp" android:textColor="@color/glass_text_primary"/>
</LinearLayout>
