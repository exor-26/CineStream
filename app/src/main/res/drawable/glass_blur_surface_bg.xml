<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_surface_stroke" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape>
            <gradient
                android:angle="270"
                android:startColor="@color/glass_surface_highlight"
                android:centerColor="@color/glass_surface_center"
                android:endColor="@color/glass_surface_shadow" />
            <corners android:radius="27dp" />
        </shape>
    </item>
</layer-list>
