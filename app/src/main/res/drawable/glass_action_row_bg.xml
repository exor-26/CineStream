<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="?attr/cineGlassPressedColor" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape>
            <solid android:color="@color/glass_row_selected" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_text_accent" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/glass_row_default" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
