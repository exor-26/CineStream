<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/glass_secondary_pressed" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_surface_stroke" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/glass_secondary_default" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_surface_stroke" />
        </shape>
    </item>
</selector>
