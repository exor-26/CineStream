<resources>
    <!-- Base application theme -->
    <style name="Base.Theme.CineStream" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="colorBackground">#FFFFFF</item>
        <item name="colorOnBackground">#000000</item>
        <item name="android:statusBarColor">@color/colorBackground</item>
    </style>

    <!-- ADD THIS - Splash Screen Theme -->
    <style name="SplashTheme" parent="Base.Theme.CineStream">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>

    <!-- Theme for Custom File Explorer (Light Mode) -->
    <style name="PlayerFullScreenTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item> <!-- Transparent status bar -->
        <item name="android:windowTranslucentNavigation">true</item>
    </style>

    <style name="GlassBottomSheetDialogTheme" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/GlassBottomSheetStyle</item>
    </style>

    <style name="GlassBottomSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.ExtraLarge</item>
    </style>

    <style name="GlassAboutSectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/glass_text_accent</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="GlassAboutBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:textColor">@color/glass_text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
